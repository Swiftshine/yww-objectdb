{
    "MapObjSet": {
        "egg_box": {
            "description": "Dispenses yarn balls.",
            "display_name": "Yarn Basket",
            "parameters": {
                "Random": {
                    "data_type": "bool",
                    "slot": 0,
                    "description": "Indicates if the dispensed yarn balls have a random color."
                },
                "Color": {
                    "data_type": "dropdown_int",
                    "slot": 1,
                    "description": "Indicates the color of the yarn ball.",
                    "note": "If \"Random\" is set, this value is ignored.",
                    "values": {
                        "Red": 0,
                        "Orange": 1,
                        "Yellow": 2,
                        "Light Green": 3,
                        "Green": 4,
                        "Light Blue": 5,
                        "Dark Blue": 6,
                        "Purple": 7,
                        "Pink": 8,
                        "White": 9,
                        "Dark Gray": 10,
                        "Light Gray": 11,
                        "Brown": 12
                    }
                },
                "Yarn Ball Size": {
                    "data_type": "dropdown_int",
                    "slot": 2,
                    "description": "Indicates the size of the yarn balls.",
                    "note": "The default value is small, with a random chance of it being big.",
                    "values": {
                        "Default": 0,
                        "Small": 1,
                        "Medium": 2,
                        "Big": 3
                    }
                },
                "Forbidden Colors": {
                    "data_type": "string",
                    "slot": 1,
                    "description": "These colors are not allowed to be dispensed.",
                    "notes": [
                        "Enter the numeric values of each color in a comma-separated list. Example: \"1,2,3\"",
                        "If no colors are allowed, the game will crash."
                    ]
                }
            }
        },
        "knit_pipe": {
            "display_name": "Pipe (Top)",
            "parameters": {
                "Cannot Enter": {
                    "data_type": "bool",
                    "slot": 1,
                    "description": "If checked, this pipe will not be enterable."
                },
                "Color": {
                    "data_type": "dropdown_int",
                    "slot": 2,
                    "description": "Indicates the color of the pipe.",
                    "note": "The default value is green.",
                    "values": {
                        "Default": 0,
                        "Red": 1,
                        "Orange": 2,
                        "Yellow": 3,
                        "Light Green": 4,
                        "Green": 5,
                        "Light Blue": 6,
                        "Dark Blue": 7,
                        "Purple": 8,
                        "Pink": 9,
                        "White": 10,
                        "Dark Gray": 11,
                        "Light Gray": 12,
                        "Brown": 13
                    }
                },
                "Rotation": {
                    "data_type": "float",
                    "slot": 0,
                    "note": "In degrees."
                },
                "Warp From": {
                    "data_type": "string",
                    "slot": 0,
                    "description": "The player exits this pipe from a pipe with the specified tag."
                },
                "Warp To": {
                    "data_type": "string",
                    "slot": 1,
                    "description": "The player enters this pipe and goes to a pipe with the specified tag."
                }
            }
        },
        "question_cloud_wing": {
            "description": "When hit, this cloud makes something happen or appear.",
            "display_name": "Question Cloud",
            "parameters": {
                "Hidden": {
                    "data_type": "bool",
                    "slot": 0,
                    "description": "Indicates if the Question Cloud spawns hidden."
                },
                "Spawn Upwards": {
                    "data_type": "bool",
                    "slot": 2,
                    "description": "If spawning an object, the object is spawned upwards."
                }
            }
        }
    },
